{
  "name": "agy-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install-all": "npm run build:user && node studio/cli.mjs install",
    "build:user": "node -e \"import('./studio/build.mjs').then(m => m.buildUserCustomJs()).then(r => console.log(JSON.stringify({ ok: true, bytes: r.bytes })))\"",
    "deploy": "node studio/cli.mjs deploy",
    "doctor": "node studio/cli.mjs doctor",
    "sync-rules": "node studio/cli.mjs sync-rules",
    "rollback": "node studio/cli.mjs rollback",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push .githooks/guard-main-branch.mjs",
    "test": "npm run build:user && node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1"
  }
}
