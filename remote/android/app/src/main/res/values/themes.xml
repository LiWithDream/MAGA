<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AGYRemote" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rc_accent</item>
        <item name="android:windowBackground">@color/rc_surface_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AGYRemote.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rc_surface_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AGYRemote</item>
    </style>
</resources>
