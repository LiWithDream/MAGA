{
  "maga-git-workflow": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/git-guard.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/git-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
